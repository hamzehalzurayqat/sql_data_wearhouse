-- the duplicates 
if exists( 
	select [customer_id], count(*) 
	from [DataWarehouse].[gold].[dim_customer]
	group by [customer_id]
	having count(*)> 1 )
	print 'duplicates found'

else
	print 'no duplicates '

-- the gender 
if exists( select distinct gender from gold.dim_customer where gender not in ('Male','Female','n/a')) 

	print 'unexpected values in gender'
else 
	print 'gender value are : (Male,Female,n/a)'


PRINT '===============================================================';
