PRINT '                      THE DIM_CUSTOMER                   ';
PRINT '===============================================================';

      create view gold.dim_customer as 
      SELECT
      row_number() over (order by cst_id) as customer_key,-- surrogate key : unique identifier
      ci.cst_id as customer_id,
      ci.cst_key as customer_number,
      ci.cst_firstname as first_name ,
      ci.cst_lastname as last_name ,
      ci.cst_marital_status as marital_status,
      coalesce(cast(ca.bdate as date), '1900-01-01') as birthdate,
      la.cntry as country,
      
         case 
            when ci.cst_gndr != 'n/a' then ci.cst_gndr -- crm is the master for gender infromation
            else coalesce(ca.gen, 'n/a')
        end as gender,
        ci.cst_create_date as create_date
      FROM silver.crm_cust_info as ci
      left join silver.erp_cust_az12 as ca 
      on ci.cst_key = ca.cid
      left join silver.erp_loc_a101 as la 
      on ci.cst_key = la.cid

PRINT '===============================================================';
PRINT '                      THE DIM_PRODCUT                    ';
PRINT '===============================================================';

create view gold.dim_prodcut as 
SELECT 
    row_number() over (order by prd_start_dt,prd_key) as product_key,-- surrogate key : unique identifier
    pn.prd_id as product_id ,
    pn.prd_key as product_number,
    pn.prd_nm as prodcut_name,
    pn.cat_id as category_id,
    eg.cat as category_name,
    eg.subcat as subcategory_name,
    pn.prd_cost as prodcut_cost,
    pn.prd_line as prodcut_line,
    pn.prd_start_dt as start_date,
    eg.maintenance
FROM silver.crm_prd_info AS pn
left join silver.erp_px_cat_g1v2 as eg
on pn.cat_id = eg.id
where pn.prd_end_dt is null -- filter out all the historical data )


PRINT '===============================================================';
PRINT '                      THE FACT_SALES                    ';
PRINT '===============================================================';

create view gold.fact_sales as 
SELECT
    sd.sls_ord_num as order_number,
    pr.[product_key],
    cr.customer_key,
    sd.sls_order_dt as order_date,
    sd.sls_ship_dt as ship_date,
    sd.sls_due_dt as due_ship_date,
    sd.sls_sales as sales_amount,
    sd.sls_quantity as quantity,
    sd.sls_price as price
  FROM silver.crm_sales_details as sd
  left join gold.dim_prodcut as pr
  on sd.sls_prd_key = pr.[product_number]
  left join  gold.dim_customer as cr 
  on sd.sls_cust_id = cr.customer_id
